# ==============================================================================
# Smart Education Project — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the project root and configure your local paths:
#   copy .env.example .env
#
# All paths can be absolute (e.g., D:\Datasets\EdNet-KT3\KT3) or relative to the project root.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dataset Storage Locations (External Read-Only Datasets)
# ------------------------------------------------------------------------------
# Path to the directory containing raw student interaction CSV files (e.g., u1.csv, u2.csv)
# On full EdNet-KT3, this contains ~298k user CSV files.
EDNET_KT3_ROOT=path/to/EdNet-KT3/KT3

# Path to the directory containing EdNet metadata tables:
# Must contain questions.csv, lectures.csv, etc.
EDNET_CONTENTS_ROOT=path/to/EdNet-Contents/contents

# Optional development / test subset directories (if using legacy dev/test splits)
EDNET_KT3_DEV_DIR=
EDNET_KT3_TEST_DIR=

# ------------------------------------------------------------------------------
# 2. Output & Processed Data Locations
# ------------------------------------------------------------------------------
# Directory where reconstructed interaction tables, user splits, and vocabularies are stored:
PROCESSED_DATA_ROOT=data/processed

# General output root for logs, reports, and plots (defaults to project root):
OUTPUT_ROOT=.

# Checkpoints directory for model weights (.pth, .pt):
CHECKPOINT_ROOT=models/checkpoints

# ------------------------------------------------------------------------------
# 3. Execution & Hardware Parameters
# ------------------------------------------------------------------------------
# Execution mode: 'smoke' (25 users), 'dev' (1,000 users), or 'full' (~298k users)
SMART_EDU_MODE=dev

# Device override (optional: 'cuda', 'cpu')
# PyTorch automatically selects CUDA if an NVIDIA GPU is detected.
DEVICE=cuda

# ------------------------------------------------------------------------------
# 4. Optional Ollama Generative AI Configuration
# ------------------------------------------------------------------------------
# Set to 'true' if running Ollama locally for pedagogical explanations
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=35
